    "tauri:build": "tauri build",
    "tauri:android": "tauri android build --apk --aab",
    "tauri:ios": "tauri ios build",
    "sync:harmony": "node scripts/build-harmony-assets.mjs"
  },
  "dependencies": {
    "idb": "^8.0.4",
