{
  "name": "qingyue",
  "version": "1.0.24",
  "private": true,
  "description": "轻阅 QINGYUE · 本地优先的纯离线 txt 阅读器",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
